# ================================================================
# Second Brain - Unified Environment Configuration
# Works for both local development (`npm run dev`) and Docker (`docker compose up`)
# ================================================================

# --- Server Configuration ---
PORT=3000
HOST_PORT=3000
NODE_ENV=development

# --- Database Selection ---
# Options: 'sqlite' (default, zero-setup local storage) | 'supabase' (cloud PostgreSQL)
DB_CLIENT=sqlite
SQLITE_DB_PATH=./db/second_brain.sqlite

# --- Docker SQLite Host Storage Path (Optional) ---
# Directory on your host server to store SQLite database file:
# Example (Linux): /var/lib/second-brain/db
# Example (Windows): D:/server-data/db
SQLITE_HOST_DIR=./db

# --- JWT Authentication ---
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_64_characters_long_123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- Supabase / PostgreSQL (Only required if DB_CLIENT=supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

